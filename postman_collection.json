              "",
              "pm.test(\"Guardar token limpio en variables\", function () {",
              "    var jsonData = {};",
              "    try {",
              "        jsonData = pm.response.json();",
              "    } catch (e) {",
              "        console.log(\"No JSON response\", e);",
              "    }",
              "",
              "    var token = jsonData.token || jsonData.access_token || (jsonData.data && jsonData.data.token) || \"\";",
              "    token = (\"\" + token).replace(/^\\\"+|\\\"+$/g, \"\").trim();",
              "    console.log(\">> token extraído:\", token);",
              "    pm.expect(token, \"token should exist\").to.not.be.empty;",
              "",
              "    try { pm.collectionVariables.unset(\"token\"); } catch(e) {}",
              "    try { pm.environment.unset(\"token\"); } catch(e) {}",
              "    try { pm.globals.unset(\"token\"); } catch(e) {}",
              "",
              "    pm.collectionVariables.set(\"token\", token);",
              "    pm.environment.set(\"token\", token);",

              "    var refreshToken = jsonData.refreshToken || (jsonData.data && jsonData.data.refreshToken) || \"\";",
              "    pm.collectionVariables.set(\"refreshToken\", refreshToken);",
              "});"
            ],
